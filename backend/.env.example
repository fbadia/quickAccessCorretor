# Supabase — usar credenciais do projeto de cada ambiente
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Superadmin inicial (criado no 1º boot se não existir). Nunca commitar valores reais.
# Senha com no mínimo 12 caracteres; troque-a no primeiro login.
SUPERADMIN_EMAIL=seu_email_superadmin@exemplo.com
SUPERADMIN_INITIAL_PASSWORD=defina_uma_senha_forte_aqui

# Google Gemini AI
GEMINI_API_KEY=sua_gemini_api_key_aqui

# Google Drive (opcional, se usar sync via Drive)
GOOGLE_DRIVE_FOLDER_ID=seu_folder_id_aqui
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Porta do servidor (opcional — padrão 3001, Render usa PORT automático)
PORT=3001

# LGPD & Criptografia (ADR-007)
# Chaves AES-256 (32 bytes em hexadecimal = 64 caracteres hex)
# Gere usando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_ENCRYPTION_KEY=exemplo_chave_64_chars_hex_para_arquivos_storage_policies
DB_ENCRYPTION_KEY=exemplo_chave_64_chars_hex_para_campos_sensíveis_do_banco
SEARCH_HMAC_KEY=exemplo_chave_64_chars_hex_para_blind_index_deterministico
